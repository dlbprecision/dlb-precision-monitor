<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DlbPrecision.Updater</AssemblyName>
    <RootNamespace>DlbPrecision.Updater</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\DlbPrecision.Monitor\Assets\monitor.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>DLB Precision Monitor</Product>
    <Description>DLB Precision Monitor updater</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
    <EmbeddedResource Include="..\DlbPrecision.Monitor\Assets\monitor.ico" LogicalName="DlbPrecision.Updater.monitor.ico" />
  </ItemGroup>
</Project>
